---
import Layout from '../layouts/Layout.astro';

const stats = [{'val': '100%', 'lbl': 'Daging Sapi Halal'}, {'val': '5 Level', 'lbl': 'Pedas Mercon'}, {'val': '0%', 'lbl': 'Bahan Pengawet'}, {'val': '1.000+', 'lbl': 'Mangkok Terjual / Hari'}];
const items = [{'name': 'Bakso Urat Super Jumbo', 'desc': '1 Bakso urat besar tekstur krekes garing + 4 bakso halus + mie bihun kuah gurih.', 'price': 'Rp 22.000', 'tag': 'Best Seller'}, {'name': 'Bakso Mercon Meledak', 'desc': 'Bakso isi cabai rawit melimpah yang meledak pedasnya saat digigit.', 'price': 'Rp 25.000', 'tag': 'Super Spicy'}, {'name': 'Bakso Telur Utuh Kuah Kaldu', 'desc': 'Bakso daging sapi besar berisi 1 butir telur ayam utuh berkualitas.', 'price': 'Rp 20.000', 'tag': 'Favorite'}, {'name': 'Mie Ayam Bakso Komplit', 'desc': 'Mie kenyal topping ayam bumbu rempah melimpah + 2 pentol bakso daging.', 'price': 'Rp 18.000', 'tag': 'Kenyang'}];
const features = [{'icon': '🥩', 'title': 'Daging Sapi Segar Setiap Hari', 'desc': 'Diolah dari daging sapi segar tanpa campuran bahan kimia.'}, {'icon': '🍲', 'title': 'Kuah Kaldu Sumsum Asli', 'desc': 'Rebusan tulang sumsum sapi lebih dari 8 jam untuk rasa gurih alami.'}, {'icon': '🌶️', 'title': 'Sambal Cabai Rawit Asli', 'desc': 'Sambal racikan sendiri tanpa pewarna atau perisa sintetis.'}];
---

<Layout title="Pentol Nikmat — Kuliner Bakso Sapi Asli">
  <section class="hero">
    <div class="container">
      <div class="hero-badge">
        🥣 100% Daging Sapi Pilihan Tanpa Pengawet
      </div>
      <h1 class="hero-title">PEDES NAMPOL, BAKSO SAPI DAGING ASLI</h1>
      <p class="hero-desc">Pentol urat krekes, bakso mercon pedas meledak, dan kuah kaldu sapi kaya rempah yang bikin nagih dari suapan pertama.</p>
      
      <div style="display: flex; gap: 1rem; justify-content: center; align-items: center;">
        <a href="https://wa.me/6281234567890" class="btn-cta">
          Pesan Sekarang via WhatsApp
        </a>
        <a href="#katalog" style="padding: 0.75rem 1.5rem; border-radius: 99px; border: 1px solid var(--card-border); color: var(--text-main); font-weight: 600;">
          Lihat Katalog
        </a>
      </div>

      <div class="stats-grid">
        {stats.map((stat) => (
          <div class="stat-card">
            <div class="stat-val">{stat.val}</div>
            <div class="stat-lbl">{stat.lbl}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="katalog" class="catalog-section">
    <div class="container">
      <h2 class="section-title">PILAHAN PRODUK & LAYANAN UNGGULAN</h2>
      <div class="item-grid">
        {items.map((item) => (
          <div class="item-card">
            <div>
              <span class="item-tag">{item.tag}</span>
              <h3 class="item-name">{item.name}</h3>
              <p class="item-desc">{item.desc}</p>
            </div>
            <div class="item-footer">
              <span class="item-price">{item.price}</span>
              <a href="https://wa.me/6281234567890" style="color: var(--accent); font-weight: 700; font-size: 0.9rem;">Pesan &rarr;</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="keunggulan" class="features-section">
    <div class="container">
      <h2 class="section-title">KENAPA PENTOL NIKMAT BEDA?</h2>
      <div class="features-grid">
        {features.map((feat) => (
          <div class="feature-card">
            <div class="feature-icon">{feat.icon}</div>
            <h3 class="feature-title">{feat.title}</h3>
            <p class="feature-desc">{feat.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
